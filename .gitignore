# XcodeGen owner-managed outputs
*.xcodeproj/xcuserdata/

# Xcode
DerivedData/
build/
*.xcworkspace/xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# SwiftPM
.build/
.swiftpm/

# ONNX models are downloaded by the build machine, not kept in Git.
Resources/ONNX/*
!Resources/ONNX/.gitkeep
!Resources/ONNX/THIRD_PARTY_NOTICES.txt
!Resources/ONNX/LICENSE-APACHE-2.0.txt
!Resources/ONNX/LICENSE-MIT-PHONEMIZER.txt

# Staged resources copied into the generated iOS app bundle.
.build-resources/ONNX/*
!.build-resources/ONNX/.gitkeep
